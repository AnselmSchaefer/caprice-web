# Response headers for every file the Worker serves (Cloudflare reads this from web/dist, and so
# does web/serve.mjs, so local tests see what readers get). web/csp.mjs adds the
# Content-Security-Policy to the /* rule after each build. Rules that match the same file add
# their headers together, so each header is set by one rule only.
# Without the first two the page gets no shared memory, and the workers cannot start.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The page itself is never kept: it names this build's files, and a page kept from the build
# before (a tab restored, going back to it) asked for files a new build had taken away, and stayed
# on "opening" until the browser's history was cleared. worker.js and the snippets keep their
# names across builds (the snippets' folder is named for the crate, not their contents), so they
# are asked about each time: kept for good, a snippet's old copy failed the integrity the new page
# asks of it, and kept failing however often the page was reloaded.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/worker.js
  Cache-Control: no-cache
/snippets/*
  Cache-Control: no-cache

# Named by their contents, so a new build gives new names: kept a year, never asked for again.
/caprice-web-*
  Cache-Control: public, max-age=31536000, immutable
/icon-*
  Cache-Control: public, max-age=31536000, immutable

# The fonts keep their names; a day, then asked again.
/fonts/*
  Cache-Control: public, max-age=86400
