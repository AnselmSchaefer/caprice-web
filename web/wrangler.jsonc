// The Cloudflare Worker that serves Caprice Web: static files from web/dist (built by
// web/build.sh), and its own code for /api/* only (api/worker.js: signing in, stories online).
// Deployed by hand: `npx wrangler deploy`, here in web/. See DEPLOY_PLAN.md and CLOUD_PLAN.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caprice-web",
  "main": "./api/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    // Every other path is a static file, served free without running the Worker.
    "run_worker_first": ["/api/*"]
  },
  // The stories: private, reached only through the Worker.
  "r2_buckets": [{ "binding": "STORIES", "bucket_name": "caprice-stories" }],
  // Who has signed up, which version of each story is current, and every limit (api/ledger.js).
  // And each story's room, where the devices it is open on meet (api/room.js).
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }, { "name": "ROOMS", "class_name": "StoryRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }, { "tag": "v2", "new_sqlite_classes": ["StoryRoom"] }],
  // Variables set in the dashboard stay across deploys: SYNC_OFF = "1" switches stories online off,
  // SCENES_OFF = "1" painting scenes, LIVE_OFF = "1" stories live on several devices.
  "keep_vars": true,
  "vars": {
    // Not secrets: they are in the sign-in links. The secrets are `wrangler secret put`:
    // SESSION_SECRET, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET (empty: that sign-in is off), and
    // ANTHROPIC_API_KEY (unset: no scenes are painted), ADMIN_TOKEN (unset: no /api/admin/scenes).
    "GOOGLE_CLIENT_ID": "622424153224-01gec9o2ustpp7gfmdkv27psoosjb941.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "",
    // They keep R2 inside its free amounts (10 GB, a million writes, ten million reads a month).
    "SITE_WRITES_PER_DAY": "20000",
    "SITE_READS_PER_DAY": "250000",
    "SITE_BYTES": "8000000000",
    "SITE_ACCOUNTS_PER_DAY": "200",
    "USER_WRITES_PER_MINUTE": "10",
    "USER_WRITES_PER_DAY": "500",
    "USER_BYTES": "100000000",
    "FILE_BYTES": "25000000",
    "HISTORY": "3",
    "HISTORY_APART_HOURS": "6",
    // Claude bills each scene: at most 10 a day for everyone together while the credit is small
    // (50 later), each at most 160 KB sent and 32,000 tokens written, so a scene costs at most
    // about $1.30 with Opus 5.5 (usually $0.25-0.45).
    "SITE_SCENES_PER_DAY": "10",
    "SCENE_PROMPT_BYTES": "160000",
    "SCENE_TOKENS": "32000",
    // A story live on several devices: connections a day for the site, messages a day for one
    // story. Durable Objects on the free plan allow 100,000 requests a day for the whole site,
    // stories online included, and each message in is one: a writer sends at most one a second
    // while typing, a few thousand in a day of writing. See LIVE_PLAN.md.
    "SITE_LIVE_PER_DAY": "1000",
    "ROOM_MESSAGES_PER_DAY": "5000"
  }
}
